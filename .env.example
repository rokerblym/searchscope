# Server only. Keep .env ignored. Never set VITE_SERPAPI_API_KEY.
SERPAPI_API_KEY=
# serpapi makes real, potentially billed API requests when explicitly submitted.
# demo produces clearly labelled synthetic results without external requests.
SEARCH_PROVIDER=serpapi
SEARCH_RETENTION_DAYS=30
# Conservative attempted-provider-request budgets per UTC day, including errors.
SERPAPI_USER_DAILY_LIMIT=20
SERPAPI_GLOBAL_DAILY_LIMIT=200
