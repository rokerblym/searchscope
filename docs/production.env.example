# Template only. Copy to ignored .env.production for local review, or bind
# runtime values securely in the deployment platform. Never commit real values.
RAILS_ENV=production
MONGODB_URI=
SECRET_KEY_BASE=
# Comma-separated approved hostnames. Nonempty in production; no broad wildcard.
ALLOWED_HOSTS=
# Safe initial review mode: synthetic results and no paid external calls.
SEARCH_PROVIDER=demo
SERPAPI_API_KEY=
SEARCH_RETENTION_DAYS=30
SERPAPI_USER_DAILY_LIMIT=20
SERPAPI_GLOBAL_DAILY_LIMIT=200
RAILS_MAX_THREADS=3
RAILS_LOG_LEVEL=info
