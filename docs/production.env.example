# Template only. Copy to ignored .env.production for local review, or bind
# runtime values securely in the deployment platform. Never commit real values.
RAILS_ENV=production
MONGODB_URI=
SECRET_KEY_BASE=
# Comma-separated approved hostnames. On Render combined hosting, omit this
# variable entirely to use the exact validated RENDER_EXTERNAL_HOSTNAME.
# An explicitly empty value is rejected; no broad wildcard is accepted.
ALLOWED_HOSTS=
# Set true only for the combined image; keep false for separate Rails/nginx.
SERVE_FRONTEND=false
# Set true only behind a trusted TLS gateway with a private HTTP listener.
RAILS_ASSUME_SSL=false
# Separate backend defaults to 3000; combined image defaults to 10000.
PORT=3000
# Safe initial review mode: synthetic results and no paid external calls.
SEARCH_PROVIDER=demo
SERPAPI_API_KEY=
SEARCH_RETENTION_DAYS=30
SERPAPI_USER_DAILY_LIMIT=20
SERPAPI_GLOBAL_DAILY_LIMIT=200
RAILS_MAX_THREADS=3
RAILS_LOG_LEVEL=info
